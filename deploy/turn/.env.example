# Copy to .env (never commit .env). The same TURN_SECRET goes into Deskstream's environment.

# Long random shared secret, e.g.:  openssl rand -base64 48
TURN_SECRET=

# Your TURN hostname (also the coturn realm), e.g. turn.example.com
TURN_REALM=

# The VPS's public IPv4 address
EXTERNAL_IP=

# Folder on the VPS holding fullchain.pem and privkey.pem for TURN_REALM, e.g.
# /etc/letsencrypt/live/turn.example.com  (coturn must be able to read them)
TURN_CERT_DIR=
